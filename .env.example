# LLM (optional - system runs in offline mode without it)
GROQ_API_KEY=
AYURIP_LLM_MODEL=openai/gpt-oss-120b
AYURIP_LLM_ENABLED=true

# Storage
AYURIP_DATA_DIR=./data
AYURIP_KB_DIR=./knowledge_base

# Retrieval
AYURIP_DENSE_ENABLED=auto
AYURIP_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Graph backend: networkx | neo4j
AYURIP_GRAPH_BACKEND=networkx
